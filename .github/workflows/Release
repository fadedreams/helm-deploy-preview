name: release

on:
  push:
    tags:
      - "v*"

permissions:
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Check tag matches plugin.yaml version
        run: |
          tag="${GITHUB_REF_NAME#v}"
          version="$(grep '^version:' plugin.yaml | head -n1 | sed -E 's/version:[[:space:]]*"?([^"]*)"?.*/\1/')"
          if [ "$tag" != "$version" ]; then
            echo "::error::Tag ($tag) does not match plugin.yaml version ($version)"
            exit 1
          fi

      - name: ShellCheck
        run: shellcheck -S warning ./*.sh

      - name: Create GitHub release
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: gh release create "$GITHUB_REF_NAME" --title "$GITHUB_REF_NAME" --generate-notes
